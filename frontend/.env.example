# The backend the Vite dev server proxies API requests to (see
# vite.config.ts). Not read by the app code directly.
VITE_BACKEND_URL=http://localhost:8000

# Only set this if the backend is served from a different origin with no
# proxy in front of it (e.g. a non-Vite production build). Leave unset to
# use same-origin relative requests, which is what keeps auth cookies
# working - see the comment in src/lib/config.ts.
# VITE_API_BASE_URL=

# Optional: enables Sentry error tracking (src/lib/monitoring.ts). Unset by
# default - the app behaves identically without it.
# VITE_SENTRY_DSN=
