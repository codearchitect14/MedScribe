ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://medscribe:medscribe@localhost:5442/medscribe
SYNC_DATABASE_URL=postgresql+psycopg2://medscribe:medscribe@localhost:5442/medscribe

REDIS_URL=redis://localhost:6389/0

JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CSRF_SECRET=replace-with-a-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

FRONTEND_ORIGIN=http://localhost:5173

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

LLM_PRIMARY_PROVIDER=groq
LLM_SECONDARY_PROVIDER=gemini
LLM_LOAD_BALANCE_STRATEGY=primary_first

GROQ_REQUESTS_PER_MINUTE=25
GROQ_REQUESTS_PER_DAY=800
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_REQUESTS_PER_DAY=1000

LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_CACHE_TTL_SECONDS=86400

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

CODING_CANDIDATES_PER_TABLE=5

LIVE_TRANSCRIPTION_ENABLED=true
LIVE_SAMPLE_RATE_HZ=16000
LIVE_PARTIAL_INTERVAL_SECONDS=1.5
LIVE_FINALIZE_AFTER_SECONDS=8
LIVE_MAX_SEGMENT_SECONDS=20
LIVE_WORKER_POOL_SIZE=2
